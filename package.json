{
  "name": "procesamiento",
  "description": "Módulo de Procesamiento",
  "version": "2.0.14",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "contributors": [
    "Raquel N Salva <raquelzssalva@gmail.com>",
    "Eugenio Arosteguy <eugenio.arosteguy@gmail.com>",
    "Emilio Platzer <emilioplatzer@gmail.com>"
  ],
  "repository": "codenautas/procesamiento",
  "license": "MIT",
  "main": "dist/server/app-procesamiento.js",
  "types": "dist/server/app-procesamiento.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "consistencias": "^2.0.15",
    "datos-ext": "^1.3.3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "discrepances": "^0.2.14",
    "mixin-patch": "~0.4.1",
    "mocha": "^11.8.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 14.0.0"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p src/server && tsc -p src/client && mixin-patch",
    "watch:build": "tsc -p src/server --watch",
    "test": "tsc -p src/tests && mocha --reporter spec --bail --check-leaks compile-for-test/tests/*.js",
    "start": "node dist/server/server-procesamiento.js",
    "clink": "npm prune && npm i && npm run build && npm link consistencias && npm link datos-ext && npm run build"
  },
  "qa-control": {
    "package-version": "0.3.0",
    "coverage": 90,
    "run-in": "server",
    "stability": "extending",
    "type": "lib",
    "ecmaVersion": 6
  }
}
